# URL publique Directus (défaut : https://api.literae.ch)
DIRECTUS_URL=https://api.literae.ch

# Optionnel : jeton statique en lecture si le rôle Public n’a pas accès à une collection
# DIRECTUS_TOKEN=

# Optionnel : chemin absolu vers une autre copie de la base biblique
# BIBLE_DB=/chemin/vers/bible.db

# Optionnel : domaines publics utilisés dans les liens de production
# PUBLIC_MAIN_SITE_URL=https://literae.ch
# PUBLIC_ART_SITE_URL=https://art.literae.ch
