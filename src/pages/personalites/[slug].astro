---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ArtworkCard from "../../components/ArtworkCard.astro";
import Fleur from "../../components/Fleur.astro";
import {
  fetchAllFromDirectus,
  fileIdOf,
  getAssetURL,
  looksLikeHtml,
} from "../../lib/directus";
import {
  formatPersonRoles,
  parsePersonTypes,
  personTypeLabel,
} from "../../lib/people";

export const prerender = true;

export async function getStaticPaths() {
  const relationId = (value: any) => {
    if (value && typeof value === "object") return String(value.id ?? "");
    return String(value ?? "");
  };
  const depictedIds = (work: any) =>
    Array.isArray(work.depicted)
      ? work.depicted.map((relation: any) =>
          relationId(relation?.artists_id ?? relation),
        )
      : [];

  const [people, works] = await Promise.all([
    fetchAllFromDirectus<any>(
      "artists?filter[status][_eq]=published&fields=*&sort=name",
    ),
    fetchAllFromDirectus<any>(
      "artworks?filter[status][_eq]=published&fields=id,slug,title_original,title_french,title_english,year,image,artist.id,artist.name,depicted.artists_id.id&sort=-year",
    ),
  ]);

  return people
    .filter((person) => person?.slug)
    .map((person) => {
      const id = String(person.id);
      return {
        params: { slug: String(person.slug) },
        props: {
          person,
          createdWorks: works.filter((work) => relationId(work.artist) === id),
          depictedWorks: works.filter((work) => depictedIds(work).includes(id)),
        },
      };
    });
}

const { person, createdWorks, depictedWorks } = Astro.props;
const photoSrc = getAssetURL(fileIdOf(person.photo), "medium");
const photoLarge = getAssetURL(fileIdOf(person.photo), "large");
const types = parsePersonTypes(person.type);
const role = formatPersonRoles(types) || "Personnalité";
const tags = Array.isArray(person.tags)
  ? person.tags
  : typeof person.tags === "string"
    ? person.tags.split(",").map((tag: string) => tag.trim()).filter(Boolean)
    : [];
const dates =
  person.birth_year || person.death_year
    ? [person.birth_year || "?", person.death_year || ""].join(" – ")
    : null;
---

<BaseLayout
  gallery
  title={person.name}
  description={person.short_description || `Notice de ${person.name}`}
>
  <main>
    <div class="page-wrap">
      <a href="/personalites" class="detail-back">← Toutes les personnalités</a>

      <article class="person-hero">
        <div class="person-portrait">
          {
            photoSrc ? (
              <img
                src={photoLarge || photoSrc}
                alt={person.name}
                width="900"
                height="1200"
                loading="eager"
                fetchpriority="high"
                decoding="async"
              />
            ) : (
              <div>
                <Fleur class="text-gold" />
                <span>Portrait non disponible</span>
              </div>
            )
          }
        </div>

        <div class="person-intro">
          <p class="eyebrow">{role}</p>
          <h1>{person.name}</h1>
          {person.name_latin && <p class="person-latin">{person.name_latin}</p>}
          {dates && <p class="person-dates">{dates}</p>}
          {person.short_description && (
            <p class="person-lead">{person.short_description}</p>
          )}

          {(types.length > 0 || tags.length > 0) && (
            <ul class="person-taxonomy">
              {types.map((type) => (
                <li><a href={`/personalites?types=${type}`}>{personTypeLabel(type)}</a></li>
              ))}
              {tags.map((tag: string) => (
                <li><a href={`/personalites?tags=${encodeURIComponent(tag)}`}>{tag}</a></li>
              ))}
            </ul>
          )}
        </div>
      </article>

      {
        person.biography && (
          <section class="biography" aria-labelledby="biography-title">
            <div>
              <p class="eyebrow">Parcours</p>
              <h2 id="biography-title">Biographie</h2>
            </div>
            {looksLikeHtml(person.biography) ? (
              <div class="rich-text biography-text" set:html={person.biography} />
            ) : (
              <p class="rich-text biography-text whitespace-pre-line">{person.biography}</p>
            )}
          </section>
        )
      }
    </div>

    {
      createdWorks.length > 0 && (
        <section class="person-works" aria-labelledby="created-title">
          <div class="page-wrap">
            <div class="works-head">
              <div>
                <p class="eyebrow">Dans la collection</p>
                <h2 id="created-title">Œuvres de {person.name}</h2>
              </div>
              <p>{createdWorks.length} {createdWorks.length > 1 ? "œuvres" : "œuvre"}</p>
            </div>
            <div class="catalog-grid">
              {createdWorks.map((work: any, index: number) => (
                <ArtworkCard work={work} index={index} />
              ))}
            </div>
          </div>
        </section>
      )
    }

    {
      depictedWorks.length > 0 && (
        <section class="person-works depicted" aria-labelledby="depicted-title">
          <div class="page-wrap">
            <div class="works-head">
              <div>
                <p class="eyebrow">Iconographie</p>
                <h2 id="depicted-title">{person.name} dans les œuvres</h2>
              </div>
              <p>{depictedWorks.length} représentations</p>
            </div>
            <div class="catalog-grid">
              {depictedWorks.map((work: any, index: number) => (
                <ArtworkCard work={work} index={index} />
              ))}
            </div>
          </div>
        </section>
      )
    }
  </main>
</BaseLayout>

<style>
  main {
    padding-top: clamp(2rem, 4vw, 3.5rem);
  }

  .detail-back {
    color: var(--text-subtle);
    font-family: var(--type-ui);
    font-size: 0.66rem;
    letter-spacing: 0.08em;
    text-decoration: none;
    text-transform: uppercase;
  }

  .person-hero {
    display: grid;
    grid-template-columns: minmax(15rem, 0.62fr) minmax(0, 1.38fr);
    gap: clamp(3rem, 8vw, 8rem);
    align-items: center;
    padding: 2.2rem 0 clamp(4.5rem, 9vw, 8rem);
  }

  .person-portrait {
    display: grid;
    aspect-ratio: 3 / 4;
    place-items: center;
    overflow: hidden;
    background: var(--bg-secondary);
  }

  .person-portrait img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: saturate(0.8);
  }

  .person-portrait > div {
    display: grid;
    justify-items: center;
    gap: 1rem;
    color: var(--text-subtle);
    font-family: var(--type-ui);
    font-size: 0.65rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .person-portrait :global(svg) {
    width: 5rem;
    opacity: 0.45;
  }

  .person-intro h1 {
    max-width: 12ch;
    margin-top: 0.8rem;
  }

  .person-latin {
    margin-top: 0.8rem;
    color: var(--text-subtle);
    font-style: italic;
  }

  .person-dates {
    margin-top: 0.8rem;
    color: var(--gold);
    font-family: var(--type-display);
    font-size: 1.5rem;
  }

  .person-lead {
    max-width: 40rem;
    margin-top: 2rem;
    color: var(--text-muted);
    font-size: clamp(1.1rem, 2vw, 1.35rem);
    line-height: 1.6;
  }

  .person-taxonomy {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
    margin-top: 2rem;
  }

  .person-taxonomy a {
    display: inline-flex;
    padding: 0.3rem 0.65rem;
    border: 1px solid var(--border);
    border-radius: 2px;
    color: var(--text-muted);
    font-family: var(--type-ui);
    font-size: 0.65rem;
    text-decoration: none;
  }

  .person-taxonomy a:hover {
    border-color: var(--accent);
    color: var(--accent);
  }

  .biography {
    display: grid;
    grid-template-columns: minmax(13rem, 0.6fr) minmax(0, 1.4fr);
    gap: clamp(3rem, 8vw, 8rem);
    padding: clamp(4rem, 8vw, 7rem) 0;
    border-top: 1px solid var(--border);
  }

  .biography h2 {
    margin-top: 0.6rem;
    font-size: clamp(2.6rem, 4.5vw, 4rem);
  }

  .biography-text {
    max-width: 47rem;
    color: var(--text-muted);
    font-size: 1.05rem;
  }

  .person-works {
    padding: clamp(4rem, 8vw, 7rem) 0;
    border-top: 1px solid var(--border);
    background: color-mix(in oklab, var(--card) 50%, var(--bg));
  }

  .person-works.depicted {
    background: var(--bg);
  }

  .works-head {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 2rem;
  }

  .works-head h2 {
    max-width: 17ch;
    margin-top: 0.6rem;
    font-size: clamp(2.5rem, 5vw, 4.5rem);
    line-height: 0.95;
  }

  .works-head > p {
    color: var(--text-subtle);
    font-family: var(--type-ui);
    font-size: 0.68rem;
    letter-spacing: 0.07em;
    text-transform: uppercase;
  }

  @media (max-width: 760px) {
    .person-hero,
    .biography {
      grid-template-columns: 1fr;
    }

    .person-portrait {
      width: min(100%, 24rem);
    }

    .works-head {
      align-items: flex-start;
      flex-direction: column;
    }
  }
</style>
